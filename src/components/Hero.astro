<section aria-labelledby="hero-heading" class="relative overflow-hidden pt-32 pb-20 lg:pt-40 lg:pb-28">
  <div class="absolute inset-0 -z-10">
    <div class="absolute inset-0 bg-gradient-to-b from-primary/20 via-transparent to-transparent" aria-hidden="true" />
    <div class="absolute -top-40 -right-40 h-[600px] w-[600px] rounded-full bg-primary/10 blur-[120px]" aria-hidden="true" />
    <div class="absolute -bottom-40 -left-40 h-[500px] w-[500px] rounded-full bg-purple-600/10 blur-[100px]" aria-hidden="true" />
    <svg viewBox="0 0 1200 600" class="absolute inset-0 h-full w-full opacity-30" aria-hidden="true">
      <defs>
        <linearGradient id="line-grad" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%" stop-color="var(--color-primary)" stop-opacity="0" />
          <stop offset="50%" stop-color="var(--color-primary)" stop-opacity="0.4" />
          <stop offset="100%" stop-color="var(--color-primary)" stop-opacity="0" />
        </linearGradient>
      </defs>
      <line x1="100" y1="100" x2="400" y2="300" stroke="url(#line-grad)" stroke-width="1" />
      <line x1="400" y1="300" x2="800" y2="150" stroke="url(#line-grad)" stroke-width="1" />
      <line x1="800" y1="150" x2="1100" y2="400" stroke="url(#line-grad)" stroke-width="1" />
      <line x1="200" y1="500" x2="400" y2="300" stroke="url(#line-grad)" stroke-width="1" />
      <line x1="400" y1="300" x2="600" y2="450" stroke="url(#line-grad)" stroke-width="1" />
      <circle cx="400" cy="300" r="4" fill="var(--color-primary)" fill-opacity="0.6" />
      <circle cx="100" cy="100" r="3" fill="#8b5cf6" fill-opacity="0.4" />
      <circle cx="800" cy="150" r="3" fill="var(--color-primary)" fill-opacity="0.4" />
      <circle cx="1100" cy="400" r="3" fill="var(--color-primary)" fill-opacity="0.4" />
      <circle cx="200" cy="500" r="3" fill="#8b5cf6" fill-opacity="0.4" />
      <circle cx="600" cy="450" r="3" fill="#8b5cf6" fill-opacity="0.4" />
    </svg>
  </div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <h1 id="hero-heading" class="text-4xl font-bold tracking-tight text-foreground sm:text-5xl md:text-6xl">
        Find Your Perfect Drive
      </h1>
      <p class="mt-6 text-lg leading-8 text-muted-foreground sm:text-xl">
        Premium pre-owned &amp; new vehicles. Certified history, transparent pricing, zero haggle.
      </p>
      <div class="mt-10 flex items-center justify-center gap-x-6">
        <a href="/" class="inline-flex items-center justify-center rounded-xl bg-primary px-8 py-3.5 text-sm font-semibold text-primary-foreground shadow-lg shadow-primary/20 transition-colors hover:bg-primary/90 focus-visible:ring-2 focus-visible:ring-ring">
          Browse Inventory
        </a>
        <a href="#finance" class="inline-flex items-center justify-center rounded-xl border border-border bg-accent px-8 py-3.5 text-sm font-semibold text-foreground transition-colors hover:bg-accent/80 focus-visible:ring-2 focus-visible:ring-ring">
          Get Pre-Approved
        </a>
      </div>
    </div>

    <div class="mt-16">
      <div class="rounded-2xl border border-border bg-accent p-2 backdrop-blur-xl shadow-2xl shadow-black/20">
        <form class="flex flex-col gap-2 sm:flex-row" action="/" method="GET">
          <div class="relative flex-1">
            <label for="make" class="sr-only">Make</label>
            <select id="make" name="make" class="h-12 w-full appearance-none rounded-lg border border-border bg-background pl-4 pr-12 text-sm text-muted-foreground focus:border-ring focus:outline-none focus-visible:ring-2 focus-visible:ring-ring">
              <option value="">All Makes</option>
              <option value="toyota">Toyota</option>
              <option value="honda">Honda</option>
              <option value="ford">Ford</option>
              <option value="bmw">BMW</option>
              <option value="hyundai">Hyundai</option>
              <option value="mazda">Mazda</option>
            </select>
            <svg class="pointer-events-none absolute right-4 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
          </div>
          <div class="relative flex-1">
            <label for="model" class="sr-only">Model</label>
            <select id="model" name="model" class="h-12 w-full appearance-none rounded-lg border border-border bg-background pl-4 pr-12 text-sm text-muted-foreground focus:border-ring focus:outline-none focus-visible:ring-2 focus-visible:ring-ring">
              <option value="">All Models</option>
              <option value="sedan">Sedan</option>
              <option value="suv">SUV</option>
              <option value="truck">Truck</option>
              <option value="hybrid">Hybrid</option>
            </select>
            <svg class="pointer-events-none absolute right-4 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
          </div>
          <div class="relative flex-1">
            <label for="price" class="sr-only">Max Price</label>
            <select id="price" name="price" class="h-12 w-full appearance-none rounded-lg border border-border bg-background pl-4 pr-12 text-sm text-muted-foreground focus:border-ring focus:outline-none focus-visible:ring-2 focus-visible:ring-ring">
              <option value="">Any Price</option>
              <option value="20000">Under ZMW371,000</option>
              <option value="35000">Under ZMW650,000</option>
              <option value="50000">Under ZMW929,000</option>
              <option value="75000">Under ZMW1,394,000</option>
            </select>
            <svg class="pointer-events-none absolute right-4 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
          </div>
          <div class="relative flex-1">
            <label for="year" class="sr-only">Year</label>
            <select id="year" name="year" class="h-12 w-full appearance-none rounded-lg border border-border bg-background pl-4 pr-12 text-sm text-muted-foreground focus:border-ring focus:outline-none focus-visible:ring-2 focus-visible:ring-ring">
              <option value="">Any Year</option>
              <option value="2024">2024</option>
              <option value="2023">2023</option>
              <option value="2022">2022</option>
              <option value="2021">2021</option>
            </select>
            <svg class="pointer-events-none absolute right-4 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
          </div>
          <button type="submit" class="h-12 rounded-lg bg-primary px-8 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90 focus-visible:ring-2 focus-visible:ring-ring">
            Browse Inventory
          </button>
        </form>
      </div>
    </div>

    <div class="mt-12">
      <p class="text-center text-xs text-muted-foreground">Trusted by 1,200+ customers across the greater Los Angeles area</p>
      <div class="mx-auto mt-6 flex max-w-2xl flex-wrap items-center justify-center gap-8 opacity-40 grayscale">
        <span class="text-lg font-bold text-muted-foreground">TOYOTA</span>
        <span class="text-lg font-bold text-muted-foreground">HONDA</span>
        <span class="text-lg font-bold text-muted-foreground">FORD</span>
        <span class="text-lg font-bold text-muted-foreground">BMW</span>
        <span class="text-lg font-bold text-muted-foreground">HYUNDAI</span>
        <span class="text-lg font-bold text-muted-foreground">MAZDA</span>
      </div>
    </div>
  </div>
</section>
