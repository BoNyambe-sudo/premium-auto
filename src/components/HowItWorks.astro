---
const steps = [
  {
    step: '01',
    title: 'Browse & Select',
    description: 'Explore our handpicked inventory online or in-person. Filter by make, model, price, or features to find your ideal match.',
    icon: 'search'
  },
  {
    step: '02',
    title: 'Secure Financing',
    description: 'Get pre-approved in minutes through our network of 20+ lenders. Transparent rates, no hidden fees, zero pressure.',
    icon: 'finance'
  },
  {
    step: '03',
    title: 'Schedule Delivery',
    description: 'Choose same-day pickup or complimentary home delivery. We handle all paperwork and inspections for you.',
    icon: 'calendar'
  },
  {
    step: '04',
    title: 'Drive Home',
    description: 'Pick up your vehicle and hit the road with confidence. Every car comes with a certified warranty and roadside assistance.',
    icon: 'car'
  }
];
---

<section aria-label="How it works" class="py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-20">
      <h2 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">How It Works</h2>
      <p class="mt-4 text-lg text-muted-foreground">Four simple steps from browsing to driving your new car home.</p>
    </div>

    <ol class="space-y-12 lg:space-y-24">
      {steps.map((item, index) => (
        <li class={`grid grid-cols-1 gap-8 lg:grid-cols-2 lg:gap-16 ${index % 2 === 1 ? 'lg:[&>*:first-child]:order-2' : ''}`}>
          <div class={`rounded-2xl border border-border bg-accent p-8 ${index % 2 === 1 ? 'lg:order-2' : ''}`}>
            <div class="flex items-center gap-4 mb-4">
              <span class="text-4xl font-bold text-primary/20">{item.step}</span>
              <div class="h-px flex-1 bg-border" aria-hidden="true" />
            </div>
            <h3 class="text-xl font-semibold text-foreground">{item.title}</h3>
            <p class="mt-3 text-muted-foreground">{item.description}</p>
          </div>
          <div class="hidden lg:flex items-center" aria-hidden="true">
            <div class="flex h-12 w-12 -translate-x-3 items-center justify-center rounded-full bg-primary text-primary-foreground shadow-lg shadow-primary/40">
              {item.icon === 'search' && (
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
              )}
              {item.icon === 'finance' && (
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>
              )}
              {item.icon === 'calendar' && (
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
              )}
              {item.icon === 'car' && (
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><path d="M14 16H9m10 0h3v-3.15a1 1 0 0 0-.84-.99L16 11l-2.7-3.6a1 1 0 0 0-.8-.4H5.24a2 2 0 0 0-1.8 1.1l-.8 1.63A6 6 0 0 0 2 12.42V16h2"/><circle cx="6.5" cy="16.5" r="2.5"/><circle cx="16.5" cy="16.5" r="2.5"/></svg>
              )}
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
