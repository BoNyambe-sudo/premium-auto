---
import inventory from '../data/inventory.json';
const featuredCars = inventory.slice(0, 6);

const formatCurrency = (value) =>
  new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: 'ZMW',
    maximumFractionDigits: 0,
  }).format(value);
---

<section aria-labelledby="featured-heading" class="py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 id="featured-heading" class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Featured Inventory</h2>
      <p class="mt-4 text-lg text-muted-foreground">Handpicked vehicles, fully inspected and ready for the road.</p>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {featuredCars.map((car) => (
        <article class="group relative flex flex-col overflow-hidden rounded-2xl border border-border bg-accent transition-all duration-300 hover:-translate-y-1 hover:border-primary/30 hover:shadow-[0_0_30px_rgba(59,130,246,0.15)]">
          <div class="relative aspect-video w-full bg-gradient-to-br from-muted to-secondary overflow-hidden">
            <div class="absolute inset-0 flex items-center justify-center">
              <svg viewBox="0 0 64 40" class="h-16 w-16 text-muted-foreground" fill="currentColor" aria-hidden="true">
                <rect x="8" y="22" width="48" height="10" rx="3" />
                <rect x="16" y="14" width="32" height="12" rx="2" />
                <circle cx="18" cy="32" r="4" />
                <circle cx="46" cy="32" r="4" />
              </svg>
            </div>
            <div class="absolute top-4 left-4">
              <span class="inline-flex items-center rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-medium text-primary ring-1 ring-primary/20">
                {car.year}
              </span>
            </div>
          </div>
          <div class="flex flex-1 flex-col p-5">
            <div class="flex-1">
              <h3 class="text-lg font-semibold text-foreground group-hover:text-primary transition-colors">
                {car.year} {car.make} {car.model}
              </h3>
              <p class="mt-1 text-sm text-muted-foreground line-clamp-2">{car.description}</p>
              <div class="mt-3 flex flex-wrap gap-2">
                <span class="inline-flex items-center gap-1 rounded-md bg-accent px-2 py-1 text-xs text-muted-foreground">
                  <svg class="h-3 w-3 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  {car.mileage.toLocaleString()} mi
                </span>
                <span class="inline-flex items-center gap-1 rounded-md bg-accent px-2 py-1 text-xs text-muted-foreground">{car.transmission}</span>
                <span class="inline-flex items-center gap-1 rounded-md bg-accent px-2 py-1 text-xs text-muted-foreground">{car.fuelType}</span>
              </div>
            </div>
            <div class="mt-5 flex items-center justify-between">
              <span class="text-xl font-bold text-white">{formatCurrency(car.price)}</span>
              <a href="/" class="inline-flex items-center justify-center rounded-lg bg-primary px-4 py-2.5 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90 focus-visible:ring-2 focus-visible:ring-ring">
                View Details
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-12 text-center">
      <a href="/" class="inline-flex items-center justify-center rounded-xl border border-border bg-accent px-8 py-3 text-sm font-semibold text-foreground transition-colors hover:bg-accent/80 focus-visible:ring-2 focus-visible:ring-ring">
        Browse All Inventory
        <svg class="ml-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>
  </div>
</section>
