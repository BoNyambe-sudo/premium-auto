---
const trustSignals = [
  {
    label: '4.9/5 Google Rating',
    sublabel: '1,200+ Reviews',
    icon: 'star'
  },
  {
    label: 'Cars.com Dealer',
    sublabel: 'Rated Dealer',
    icon: 'award'
  },
  {
    label: 'Edmunds Top Rated',
    sublabel: '2024',
    icon: 'trophy'
  },
  {
    label: 'Auto Financing',
    sublabel: 'Pre-Approved in Minutes',
    icon: 'finance'
  }
];
---

<section aria-label="Trust signals" class="border-y border-border bg-accent/30 py-6">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-wrap items-center justify-center gap-8 md:gap-16">
      {trustSignals.map((signal) => (
        <div class="flex items-center gap-3 group">
          <div class="flex h-10 w-10 items-center justify-center rounded-full bg-accent text-muted-foreground transition-colors group-hover:text-primary group-hover:bg-primary/10">
            {signal.icon === 'star' && (
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
                <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006z" clip-rule="evenodd" />
              </svg>
            )}
            {signal.icon === 'award' && (
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true">
                <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6" /><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18" /><path d="M4 22h16" /><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22" /><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22" /><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z" />
              </svg>
            )}
            {signal.icon === 'trophy' && (
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true">
                <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6" /><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18" /><path d="M4 22h16" /><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22" /><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22" /><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z" />
              </svg>
            )}
            {signal.icon === 'finance' && (
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true">
                <rect x="2" y="5" width="20" height="14" rx="2" /><line x1="2" x2="22" y1="10" y2="10"/>
              </svg>
            )}
          </div>
          <div class="text-left">
            <p class="text-sm font-medium text-white">{signal.label}</p>
            <p class="text-xs text-muted-foreground">{signal.sublabel}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
