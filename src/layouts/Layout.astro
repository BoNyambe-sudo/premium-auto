    },
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: '4.7',
      bestRating: '5',
      reviewCount: '16'
    }
  }
];

const faqPage = {
  '@type': 'FAQPage',
  '@id': `${Astro.site}${Astro.url.pathname}/#faq`,
  mainEntity: [
    { '@type': 'Question', name: 'How does financing work?', acceptedAnswer: { '@type': 'Answer', text: 'We partner with 20+ top lenders to get you pre-approved in minutes. Our finance team reviews your budget and finds the best rates available—often better than going direct to the bank. Apply online or visit the dealership.' } },
    { '@type': 'Question', name: 'What is your trade-in process?', acceptedAnswer: { '@type': 'Answer', text: 'Get a fair market value estimate instantly through our online appraisal tool. We evaluate your vehicle using current market data and make a transparent offer on the spot—no negotiations, no pressure.' } },
    { '@type': 'Question', name: 'Can I test drive a vehicle?', acceptedAnswer: { '@type': 'Answer', text: 'Absolutely. Schedule a test drive online or by phone. We offer flexible same-day and next-day slots, including evenings and weekends for your convenience.' } },
    { '@type': 'Question', name: 'Are vehicles certified inspected?', acceptedAnswer: { '@type': 'Answer', text: 'Every vehicle undergoes a comprehensive 150-point inspection covering brakes, tires, engine, transmission, electronics, and safety systems. We provide a full inspection report you can review before purchase.' } },
    { '@type': 'Question', name: 'Do you offer warranties?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. All certified pre-owned vehicles include a warranty up to 7 years/100,000 miles. Extended warranty options are available for most models at competitive rates.' } },
    { '@type': 'Question', name: 'Can I get a vehicle delivered?', acceptedAnswer: { '@type': 'Answer', text: 'We offer home delivery within a 50-mile radius at no cost. For farther locations, we partner with trusted auto transporters and coordinate the entire process for you.' } }
  ]
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    organization,
    website,
    webPage,
    breadcrumbList,
    faqPage,
    ...products
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${Astro.site}/og-image.png`} />
    <meta property="og:site_name" content="Premier Auto Sales" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${Astro.site}/og-image.png`} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <slot name="head" />
  </head>
  <body class="bg-background text-foreground font-sans antialiased">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-3 focus:bg-foreground focus:text-background focus:rounded-lg focus-visible:ring-2 focus-visible:ring-ring">
      Skip to content
    </a>

    <header>
      <slot name="header" />
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer>
      <slot name="footer" />
    </footer>

    <style is:global>
      html {
        scroll-behavior: smooth;
        scroll-padding-top: 80px;
      }
      :focus-visible {
        outline: none;
        box-shadow: 0 0 0 2px var(--color-ring);
      }
      img {
        max-width: 100%;
        height: auto;
      }
      ::-webkit-scrollbar {
        width: 8px;
      }
      ::-webkit-scrollbar-track {
        background: var(--color-background);
      }
      ::-webkit-scrollbar-thumb {
        background: #333;
        border-radius: 4px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #555;
      }
    </style>

    <slot name="scripts" />
  </body>
</html>
