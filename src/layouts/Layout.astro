      '@type': 'Offer',
      price: '613707',
      priceCurrency: 'ZMW',
      availability: 'https://schema.org/InStock',
      url: `${Astro.site}/inventory/2024-toyota-camry-xse`
    },
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: '4.8',
      bestRating: '5',
      reviewCount: '24'
    }
  },
  {
    '@type': 'Product',
    name: '2023 Honda CR-V Hybrid Sport',
    description: 'Efficient CR-V Hybrid with Honda Sensing and premium Bose audio system.',
    brand: { '@type': 'Brand', name: 'Honda' },
    offers: {
      '@type': 'Offer',
      price: '668670',
      priceCurrency: 'ZMW',
      availability: 'https://schema.org/InStock',
      url: `${Astro.site}/inventory/2023-honda-cr-v-hybrid`
    },
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: '4.7',
      bestRating: '5',
      reviewCount: '31'
    }
  },
  {
    '@type': 'Product',
    name: '2024 Ford F-150 XLT',
    description: 'Powerful F-150 XLT with Pro Power Onboard and B&O Sound by Bang & Olufsen.',
    brand: { '@type': 'Brand', name: 'Ford' },
    offers: {
      '@type': 'Offer',
      price: '995007',
      priceCurrency: 'ZMW',
      availability: 'https://schema.org/InStock',
      url: `${Astro.site}/inventory/2024-ford-f-150-xlt`
    },
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: '4.9',
      bestRating: '5',
      reviewCount: '18'
    }
  },
  {
    '@type': 'Product',
    name: '2022 BMW 330i xDrive',
    description: 'Sport-tuned 330i xDrive with M Sport package and Harman Kardon premium audio.',
    brand: { '@type': 'Brand', name: 'BMW' },
    offers: {
      '@type': 'Offer',
      price: '833280',
      priceCurrency: 'ZMW',
      availability: 'https://schema.org/LimitedAvailability',
      url: `${Astro.site}/inventory/2022-bmw-330i-xdrive`
    },
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: '4.6',
      bestRating: '5',
      reviewCount: '12'
    }
  },
  {
    '@type': 'Product',
    name: '2023 Mazda CX-5 Signature',
    description: 'Luxurious CX-5 Signature with Bose Centerpoint surround and Soul Red Crystal paint.',
    brand: { '@type': 'Brand', name: 'Mazda' },
    offers: {
      '@type': 'Offer',
      price: '695640',
