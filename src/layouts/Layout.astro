---
import '../styles/global.css';
const title = 'Premier Auto Sales | New & Used Cars | Best Prices';
const description = 'Shop premium new and used vehicles with transparent pricing, certified inspections, and zero-haggle pricing. Finance online, schedule a test drive today.';
const canonical = new URL(Astro.url.pathname, Astro.site).toString();

const organization = {
  '@type': 'AutoDealer',
  '@id': `${Astro.site}/#organization`,
  name: 'Premier Auto Sales',
  url: Astro.site,
  telephone: '(555) 123-4567',
  email: 'info@premierautosales.example.com',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '1234 Auto Plaza Drive',
    addressLocality: 'Los Angeles',
    addressRegion: 'CA',
    postalCode: '90001',
    addressCountry: 'US'
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 34.0522,
    longitude: -118.2437
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '09:00',
      closes: '20:00'
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Saturday'],
      opens: '09:00',
      closes: '18:00'
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Sunday'],
      opens: '11:00',
      closes: '17:00'
    }
  ],
  priceRange: '$$',
  sameAs: [
    'https://www.facebook.com/example-premier-auto',
    'https://twitter.com/example-premier-auto'
  ]
};

const website = {
  '@type': 'WebSite',
  '@id': `${Astro.site}/#website`,
  url: Astro.site,
  name: 'Premier Auto Sales',
  publisher: {
    '@id': `${Astro.site}/#organization`
  },
  potentialAction: {
    '@type': 'SearchAction',
    target: `${Astro.site}/search?q={search_term_string}`,
    'query-input': 'required name=search_term_string'
  }
};

const webPage = {
  '@type': 'WebPage',
  '@id': `${Astro.site}${Astro.url.pathname}/#webpage`,
  url: canonical,
  name: title,
  description,
  isPartOf: {
    '@id': `${Astro.site}/#website`
  },
  inLanguage: 'en-US'
};

const breadcrumbList = {
  '@type': 'BreadcrumbList',
  '@id': `${Astro.site}${Astro.url.pathname}/#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${Astro.site}/` }
  ]
};

const products = [
  {
    '@type': 'Product',
    name: '2024 Toyota Camry XSE',
    description: 'Certified pre-owned Camry XSE with Toyota Safety Sense 3.0 and premium JBL audio.',
    brand: { '@type': 'Brand', name: 'Toyota' },
