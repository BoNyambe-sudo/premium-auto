---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import SocialProof from '../components/SocialProof.astro';
import InventoryGrid from '../components/InventoryGrid.astro';
import HowItWorks from '../components/HowItWorks.astro';
import FinanceCalculator from '../components/FinanceCalculator';
import FAQ from '../components/FAQ';
import ContactBar from '../components/ContactBar.astro';
import Footer from '../components/Footer.astro';
import { initAnimations } from '../utils/animations';
---

<Layout>
  <Header slot="header" />

  <section data-animate="fade-up">
    <Hero />
  </section>

  <SocialProof />

  <section data-animate="fade-up">
    <InventoryGrid />
  </section>

  <section data-animate="fade-up">
    <HowItWorks />
  </section>

  <section data-animate="fade-up">
    <FinanceCalculator client:visible />
  </section>

  <section id="testimonials" aria-labelledby="testimonials-heading" class="py-24 bg-accent/30">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 id="testimonials-heading" class="text-3xl font-bold tracking-tight text-white sm:text-4xl">What Our Customers Say</h2>
      </div>
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
        <blockquote class="rounded-2xl border border-border bg-accent p-8">
          <div class="flex items-center gap-1 text-star mb-4" aria-label="5 out of 5 stars">
            {[1,2,3,4,5].map(() => (
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true"><path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006z" clip-rule="evenodd" /></svg>
            ))}
          </div>
          <p class="text-muted-foreground mb-6"> Incredible experience from start to finish. The team made the whole process effortless and transparent.</p>
          <footer class="flex items-center gap-3">
            <div class="h-10 w-10 rounded-full bg-gradient-to-br from-primary to-purple flex items-center justify-center text-sm font-bold text-primary-foreground">JD</div>
            <div>
              <p class="text-sm font-medium text-white">James D.</p>
              <p class="text-xs text-muted-foreground">Purchased 2024 Toyota Camry</p>
            </div>
          </footer>
        </blockquote>

        <blockquote class="rounded-2xl border border-border bg-accent p-8">
          <div class="flex items-center gap-1 text-star mb-4" aria-label="5 out of 5 stars">
            {[1,2,3,4,5].map(() => (
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true"><path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006z" clip-rule="evenodd" /></svg>
            ))}
          </div>
          <p class="text-muted-foreground mb-6"> Best trade-in value I received anywhere. The transparent pricing and zero-haggle policy is refreshing.</p>
          <footer class="flex items-center gap-3">
            <div class="h-10 w-10 rounded-full bg-gradient-to-br from-green-500 to-teal-600 flex items-center justify-center text-sm font-bold text-primary-foreground">SK</div>
            <div>
              <p class="text-sm font-medium text-white">Sarah K.</p>
              <p class="text-xs text-muted-foreground">Purchased 2023 Honda CR-V</p>
            </div>
          </footer>
        </blockquote>

        <blockquote class="rounded-2xl border border-border bg-accent p-8">
          <div class="flex items-center gap-1 text-star mb-4" aria-label="5 out of 5 stars">
            {[1,2,3,4,5].map(() => (
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4" aria-hidden="true"><path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006z" clip-rule="evenodd" /></svg>
            ))}
          </div>
          <p class="text-muted-foreground mb-6"> The home delivery was seamless. They brought the car right to my office with all paperwork ready.</p>
          <footer class="flex items-center gap-3">
            <div class="h-10 w-10 rounded-full bg-gradient-to-br from-orange-500 to-red-600 flex items-center justify-center text-sm font-bold text-primary-foreground">MR</div>
            <div>
              <p class="text-sm font-medium text-white">Michael R.</p>
              <p class="text-xs text-muted-foreground">Purchased 2024 Ford F-150</p>
            </div>
          </footer>
        </blockquote>
      </div>
    </div>
  </section>

  <section data-animate="fade-up">
    <FAQ client:visible />
  </section>

  <ContactBar />

  <Footer slot="footer" />
</Layout>

<script type="module">
  import { initAnimations } from '../utils/animations.js';
  initAnimations();
</script>
